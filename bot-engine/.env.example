# =============================================
# BOT ENGINE - Environment Variables
# Copie este arquivo para .env e preencha os valores
# =============================================

# Token do Bot Discord
# Obtido em: https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=SEU_BOT_TOKEN

# Client ID do App Discord
DISCORD_CLIENT_ID=SEU_CLIENT_ID

# URL da Core API
# DEV:  http://localhost:4000
# PROD: https://api.orbitup.io
CORE_API_URL=http://localhost:4000

# Chave interna Bot → API (deve ser IGUAL ao INTERNAL_SERVICE_KEY da core-api)
INTERNAL_SERVICE_KEY=MUDE_ESTA_CHAVE_INTERNA

# Token WebSocket Bot ↔ API (deve ser IGUAL ao BOT_INTERNAL_TOKEN da core-api)
BOT_INTERNAL_TOKEN=MUDE_ESTE_TOKEN_WS
