# =============================================
# ORBIT AGENT - Environment Variables
# Copie este arquivo para .env e preencha os valores
# =============================================

# Token de autenticação do agente (deve ser igual ao BOT_INTERNAL_TOKEN da core-api)
AGENT_TOKEN=MUDE_ESTE_TOKEN_WS

# ID do servidor Discord que este agente representa
SERVER_ID=SEU_SERVER_ID_DISCORD

# WebSocket URL da Core API
# DEV:  ws://127.0.0.1:4000/ws/agent
# PROD: wss://api.orbitup.io/ws/agent
CORE_API_WS_URL=ws://127.0.0.1:4000/ws/agent
