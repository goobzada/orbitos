# =============================================
# SAASBOT DASHBOARD - Frontend Environment
# Copie este arquivo para .env.local e preencha os valores
# =============================================

# URL base da Core API (backend central)
# DEV:  http://localhost:4000
# PROD: https://api.orbitup.io
NEXT_PUBLIC_API_URL=http://localhost:4000

# Discord OAuth2 - URL para iniciar o login
# Formato: https://discord.com/api/oauth2/authorize?client_id=SEU_CLIENT_ID&redirect_uri=SUA_REDIRECT_URI&response_type=code&scope=identify+email
#
# DEV:  redirect_uri=http://localhost:3001/login/callback
# PROD: redirect_uri=https://orbitup.io/login/callback
NEXT_PUBLIC_DISCORD_LOGIN_URL=https://discord.com/api/oauth2/authorize?client_id=SEU_CLIENT_ID&redirect_uri=http://localhost:3001/login/callback&response_type=code&scope=identify+email

# Discord OAuth2 Credentials (server-side only — NÃO exposto ao browser)
# Obtidos em: https://discord.com/developers/applications
DISCORD_CLIENT_ID=SEU_CLIENT_ID
DISCORD_CLIENT_SECRET=SEU_CLIENT_SECRET

# JWT Secret — deve ser IGUAL ao configurado na core-api
# DEV:  qualquer string aleatória
# PROD: string longa e aleatória (use: openssl rand -base64 32)
JWT_SECRET=MUDE_PARA_UMA_CHAVE_SECRETA_LONGA
