# =============================================
# CORE API - Environment Variables
# Copie este arquivo para .env e preencha os valores
# =============================================

# Porta da API
# DEV:  4000
# PROD: 4000 (ou via reverse proxy na 443)
PORT=4000

# ─── Database ────────────────────────────────────────────────────────────────
# DEV:  postgresql://orbitos:orbitos_dev@localhost:5432/orbitos_core
# PROD: postgresql://USER:PASS@HOST:5432/orbitos_core?schema=public
DATABASE_URL=postgresql://orbitos:orbitos_dev@localhost:5432/orbitos_core?schema=public

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Deve ser IGUAL ao JWT_SECRET do .env.local do frontend
# PROD: use `openssl rand -base64 32`
JWT_SECRET=MUDE_PARA_UMA_CHAVE_SECRETA_LONGA

# ─── Internal Service Keys ────────────────────────────────────────────────────
# Chave interna Bot → API (deve ser IGUAL ao INTERNAL_SERVICE_KEY do bot-engine)
INTERNAL_SERVICE_KEY=MUDE_ESTA_CHAVE_INTERNA

# Token WebSocket API ↔ Bot (deve ser IGUAL ao BOT_INTERNAL_TOKEN do bot-engine)
BOT_INTERNAL_TOKEN=MUDE_ESTE_TOKEN_WS

# ─── Discord OAuth2 ───────────────────────────────────────────────────────────
# Obtidos em: https://discord.com/developers/applications
DISCORD_CLIENT_ID=SEU_CLIENT_ID
DISCORD_CLIENT_SECRET=SEU_CLIENT_SECRET

# Redirect URI — DEVE estar cadastrada no Discord Developer Portal
# DEV:  http://localhost:3001/login/callback
# PROD: https://orbitup.io/login/callback
DISCORD_REDIRECT_URI=http://localhost:3001/login/callback

# ─── CORS ────────────────────────────────────────────────────────────────────
# Origens permitidas (separadas por vírgula)
# DEV:  http://localhost:3000,http://localhost:3001 (padrão automático)
# PROD: https://orbitup.io,https://www.orbitup.io
# ALLOWED_ORIGINS=https://orbitup.io,https://www.orbitup.io

# ─── Stripe (Pagamentos) ─────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
